# =============================================================================
# Step by Step Coaching — variables d'environnement
#
# Copie ce fichier en `.env.local` et remplis les valeurs. `.env.local` est
# ignore par git, ce fichier-ci ne l'est pas : il ne doit JAMAIS contenir de
# valeur reelle, seulement des cles vides.
#
# Sur Vercel, ces memes variables se saisissent dans Settings > Environment
# Variables, avec un jeu distinct par environnement (Preview / Production).
#
# Ce qui n'est PAS ici, volontairement : les identifiants de prix Stripe. Ils
# vivent dans la colonne `plans.stripe_price_id`. Ajouter une formule ou passer
# en production ne doit demander aucune modification de code ni d'environnement.
# =============================================================================


# --- Site --------------------------------------------------------------------

# URL publique complete, sans slash final.
# Sert aux redirections Stripe Checkout, aux liens des emails Resend et aux
# callbacks d'authentification Supabase.
# Dev : http://localhost:3000 — Prod : https://stepbystep-guadeloupe.fr
#
# OBLIGATOIRE en production, et obligatoirement en https : sans elle les
# emails des clientes contiendraient des liens vers localhost, et Stripe
# refuserait l'URL de retour. L'application echoue au demarrage plutot que de
# se rabattre en silence.
NEXT_PUBLIC_SITE_URL=


# --- Supabase ----------------------------------------------------------------

# ATTENTION : sur le meme ecran du tableau de bord (Project Settings > Data API)
# se trouvent l'URL et les cles. Coller une cle dans la variable d'URL est
# l'erreur la plus facile a commettre, et elle casse TOUTES les routes d'un coup
# via le middleware. envSupabase() verifie desormais la forme des deux valeurs
# et le dit en clair.

# URL du projet. Commence par https:// et finit par .supabase.co
# Expose au navigateur, ce n'est pas un secret.
NEXT_PUBLIC_SUPABASE_URL=

# Cle publique. Deux formats coexistent chez Supabase :
#   - ancien : un JWT, commence par « eyJ »
#   - nouveau : commence par « sb_publishable_ »
# Les deux fonctionnent ici. Expose au navigateur, sans danger : c'est la RLS
# qui protege les donnees, pas la confidentialite de cette cle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle de service (service_role, ancien format « eyJ », ou « sb_secret_ »).
# CONTOURNE LA RLS.
# Jamais de prefixe NEXT_PUBLIC_, jamais importee dans un composant client.
# Reservee aux webhooks Stripe et aux jobs cron, cote serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=

# Chaine de connexion Postgres directe. Utile seulement pour la CLI Supabase
# (`supabase db push`, `db reset`) depuis un poste de dev. Inutile sur Vercel.
# SUPABASE_DB_URL=


# --- Stripe ------------------------------------------------------------------

# Mode test pendant tout le developpement : les cles commencent par pk_test_ /
# sk_test_. Passer en production, c'est remplacer ces valeurs, rien d'autre.

# Pas de cle publiable ici : Checkout est une redirection cote serveur, il n'y
# a pas de Stripe.js dans le navigateur. Elle redeviendra necessaire le jour ou
# un formulaire de carte sera integre dans la page.

# Cle secrete. Cote serveur uniquement.
STRIPE_SECRET_KEY=

# Secret de signature du webhook (whsec_...). Sans lui, impossible de verifier
# qu'un appel vient bien de Stripe : un tiers pourrait crediter des seances.
# En local il est fourni par `stripe listen --forward-to`, et il differe de
# celui du webhook declare dans le dashboard.
STRIPE_WEBHOOK_SECRET=


# --- Resend ------------------------------------------------------------------

# Cle API. Cote serveur uniquement.
# Une cle « Sending access » suffit : elle ne peut pas lister les domaines ni
# relire les envois, et c'est tres bien ainsi.
RESEND_API_KEY=

# Expediteur. Le domaine doit etre verifie dans Resend, sinon l'envoi est
# refuse. Format complet, nom compris.
# Ex : Step by Step <contact@stepbystep-guadeloupe.fr>
EMAIL_FROM=

# Adresse de REPONSE. Obligatoirement differente de l'expediteur :
# contact@stepbystep-guadeloupe.fr sert a envoyer mais n'a pas de boite, une
# reponse y partirait dans le vide. Toute reponse doit arriver chez Oriane.
# Vaut sbscoaching28@gmail.com par defaut si cette variable est absente.
EMAIL_REPLY_TO=

# --- Jobs planifies ----------------------------------------------------------

# Secret partage protegeant les routes de cron (expiration des lots, alerte de
# fin de validite). Vercel Cron l'envoie en `Authorization: Bearer <valeur>` ;
# la route refuse tout appel qui ne le presente pas, avec une comparaison a
# temps constant. Chaine aleatoire longue.
# Genere-la avec : openssl rand -hex 32
CRON_SECRET=

# Nombre de jours avant echeance ou part l'alerte de fin de validite.
# Valeur de depart suggeree : 3
EXPIRY_WARNING_DAYS=
